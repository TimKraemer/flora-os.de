# Öffnungszeiten aus Google Places (serverseitig, Besucher kontaktieren Google nicht)
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_ID=""

# Instagram-Feed: öffentliches Profil, kein Login nötig. Mit INSTAGRAM_SYNC=off abschalten.
INSTAGRAM_USERNAME="cafe_flora_osnabrueck"

# Ablage für den Instagram-Cache (im Container als Volume gemountet)
DATA_DIR="./data"

# Speisekarte aus dem Google-Unternehmensprofil (Google Business Profile API).
# Zugang einmalig mit scripts/google-business-login.ts holen. Ohne diese Werte
# zeigt die Website die Karte aus src/lib/menu.ts.
GOOGLE_BP_CLIENT_ID=""
GOOGLE_BP_CLIENT_SECRET=""
GOOGLE_BP_REFRESH_TOKEN=""
