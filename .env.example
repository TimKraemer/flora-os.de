# Öffnungszeiten aus Google Places (serverseitig, Besucher kontaktieren Google nicht)
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_ID=""

# Instagram-Feed (Instagram API mit Instagram-Login, Token des Kontos cafe_flora_osnabrueck).
# Nur für den ersten Start nötig: der Server verlängert das Token selbst und legt es in
# DATA_DIR/instagram/token.json ab.
INSTAGRAM_ACCESS_TOKEN=""

# Ablage für Instagram-Cache und verlängertes Token (im Container als Volume gemountet)
DATA_DIR="./data"
